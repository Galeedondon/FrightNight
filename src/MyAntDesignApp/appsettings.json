{
    "ExperienceAPI":  {
                          "FrightNightApi":  {
                                                 "Url":  "/api"
                                             }
                      },
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning"
                                 }
                },
    "ReverseProxy":  {
                         "Clusters":  {
                                          "api":  {
                                                      "Destinations":  {
                                                                           "local":  {
                                                                                         "Address":  "http://127.0.0.1:5189/"
                                                                                     }
                                                                       }
                                                  }
                                      },
                         "Routes":  {
                                        "api":  {
                                                    "ClusterId":  "api",
                                                    "Match":  {
                                                                  "Path":  "/api/{**catch-all}"
                                                              },
                                                    "Transforms":  [
                                                                       {
                                                                           "PathRemovePrefix":  "/api"
                                                                       }
                                                                   ]
                                                }
                                    }
                     }
}
