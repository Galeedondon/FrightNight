                            band files
                        </p>
                    </Upload> *@
                </FormItem>
                <FormItem Label="Date">
                    <DatePicker TValue="DateTime"   @bind-Value="@context.MemoryDate" DefaultValue="@selectedValue">
                    </DatePicker>
                </FormItem>
                <FormItem Label="Tag">
                    <Input  @bind-Value="@context.Tags" >
                        <Prefix>
