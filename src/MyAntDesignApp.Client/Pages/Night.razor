        </Modal>
        
        @{
            RenderFragment footer2 = @<Template>
            <Button OnClick="@HandleCommentCancel" @key="@( "back" )">Cancel</Button>
        </Template>;

        
        }

    
        <Modal Title="@_title" MaxBodyHeight="@("75vh")" Style="top: 12.5vh;width:77%;min-height: 75vh;max-height:75vh" @bind-Visible="@_visibleComment" Footer="@footer2" MaskClosable="false">
            <GridRow>
                <GridCol Span="24" style="text-align: center;">
                    <ImagePreviewGroup>
                        <Image Width="600" Src="@_imgUrl" />
                    </ImagePreviewGroup>
                </GridCol>
            </GridRow>
            <div class="tag-colorful-demo" style="padding-top: 20px;">
                @if(_createDate.DayOfWeek == DayOfWeek.Friday)
                {
                    <Tag Color="TagColor.Gold">@_tags</Tag>
                }
                else
                {
                    <Tag Color="TagColor.Blue">@_tags</Tag>
                }
 
                @* <Tag Color="TagColor.Volcano">volcano</Tag> *@
            </div>
            @if (comments.Count > 0)
            {
                <AntList DataSource="@comments" TItem="Data" Header="header" Class="comment-list">
                    <ListItem>
                        <Comment Actions="@context.Actions" Avatar="@context.Avatar" Author="@context.Author" DatetimeTemplate="@context.Datetime" Content="@context.Content">
                             
                            @foreach(var reply in context.DetailData)
                            {
                                <Comment Avatar="@reply.Avatar" Author="@reply.Author"  DatetimeTemplate="@reply.Datetime" Content="@reply.Content" >
                                </Comment>
                            }
                        </Comment>
                    </ListItem>
                </AntList>
            }
            <Comment Avatar="@($"/img/avatar/{userId}.png")">
                <ContentTemplate>
                    <div>
                        <TextArea MinRows="4" @bind-Value="@_value" />
