</Spin>


<Modal Title="@_commentModal"
        @bind-Visible="@_commentVisible"
        OkText="@_commentModalOK"
        CancelText="@("Cancel")"
        OnOk="CommentOk"
        OnCancel="CommentCancel"
        >
    @if(_commentModalOK =="Edit")
    {
        <Input Placeholder="Basic usage" @bind-Value="@_commentEdit"  />
    }
    else
    {
        @("你忍心刪除留言嗎 QQQ");
    }
</Modal>
 
 @if(morning)
{
    <script src="/js/cloud.js"></script>
}
else
{
    <script src="/js/start.js"></script>
}


<style>
    .ant-comment-content-author {
    width: 100%;
    display: flex;
    justify-content: space-between; /* 使兩個元素之間的空間自動分配 */
    align-items: center; /* 垂直居中對齊 */
    }

    .ant-comment-content-author-time {
    flex-grow: 1; /* 使時間元素佔用剩餘空間 */
    }

    .ant-comment {
    width: 100%;
    }

    .ant-upload.ant-upload-select-picture-card {
    width: 1200px;
    height: 800px;
    }

    .estrela 
    {
        background-color: white;
        border-radius: 50%;
        position: absolute;
        animation-name: estrela;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
    }

    .estrela.style1 {
    animation-duration: 0.5s;
    animation-name: estrela;
    }
    .estrela.style2 {
    animation-duration: 1s;
    animation-name: estrela;
    }
    .estrela.style3 {
    animation-duration: 1.5s;
    animation-name: estrela;
    }
    .estrela.style4 {
    animation-duration: 2s;
    animation-name: estrelaDestacada;
    }

    .estrela.tam1 {
    width: 1px;
    height: 1px;
    }
    .estrela.tam2 {
    width: 2px;
    height: 2px;
    }
    .estrela.tam3 {
    width: 3px;
    height: 3px;
    }

    .estrela.opacity1 {
    opacity: 1;
    }
    .estrela.opacity2 {
    opacity: 0.5;
    }
    .estrela.opacity3 {
    opacity: 0.1;
    }
    .selected-reply {
        background-color: rgba(70, 130, 180, 0.2) !important; /* 強制生效 */
        color: #007bff !important; /* 強制變藍 */
        font-weight: bold;
        box-shadow: 0 0 8px rgba(0, 123, 255, 0.5);
        border-radius: 5px;
    }

    .estrela-sun {
        background-color: white;
        border-radius: 50%;
        position: absolute;
        animation-name: estrela;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
    }

    .estrela-sun.style1 {
        animation-duration: 0.5s;
        animation-name: estrela;
    }
    .estrela-sun.style2 {
        animation-duration: 1s;
        animation-name: estrela;
    }
    .estrela-sun.style3 {
        animation-duration: 1.5s;
        animation-name: estrela;
    }
    .estrela-sun.style4 {
        animation-duration: 2s;
        animation-name: estrela;
    }

    .estrela-sun.tam1 {
        width: 1px;
        height: 1px;
    }
    .estrela-sun.tam2 {
        background: #ffffff;
        border-radius: 50%;
        box-shadow: 30px 10px 0px 0px #ffffff,
            /* 原来是 15px 5px */ -30px 10px 0px 0px #ffffff,
            /* 原来是 -15px 5px */ 10px -20px 0px 0px #ffffff,
            /* 原来是 5px -10px */ 50px -10px 0px 0px #ffffff; /* 原来是 25px -5px */
        width: 120px;
        height: 80px;
    }
    .estrela-sun.tam3 {
        width: 3px;
        height: 3px;
    }

    .estrela-sun.opacity1 {
        opacity: 1;
    }
    .estrela-sun.opacity2 {
        opacity: 0.5;
    }
    .estrela-sun.opacity3 {
        opacity: 0.1;
    }
</style>
</div>