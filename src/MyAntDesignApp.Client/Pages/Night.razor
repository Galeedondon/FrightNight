                <FormItem Label="Title">
                    <Input  @bind-Value="@context.Title" MaxLength="10" >
                        <Prefix>
                            <Icon Type="@IconType.Outline.Star" />
                        </Prefix>
                    </Input>
                </FormItem> 
                <FormItem Label="Picture">
                        <Upload Action="http://localhost:5125/Memory/Picture"
                            Name="avatar"
                            Class="avatar-uploader"
                            ListType="UploadListType.PictureCard"
                            ShowUploadList="false"
                            OnSingleCompleted="OnSingleCompleted"
                            BeforeUpload="BeforeUpload"
                            OnChange="HandleChange">
                        @if (!string.IsNullOrWhiteSpace(imageUrl))
                        {
                            <img src="@imageUrl" alt="avatar" style="width: 100%;max-height:800px" />
                        }
                        else
                        {
                            <div>
                                <Icon Spin="loading" Type="@(loading ? IconType.Outline.Loading : IconType.Outline.Plus)" />
