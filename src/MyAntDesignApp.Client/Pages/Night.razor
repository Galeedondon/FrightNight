@page "/FrightDay"
@namespace MyAntDesignApp.Pages.Components
@using MyAntDesignApp.Client.Components
@using static MyAntDesignApp.Client.Models.responseModel
<PageTitle>回憶日曆 · Friday Night</PageTitle>
<div class="app-shell @(dark ? "dark" : "")">
    <aside class="sidebar">
        <FnBrand Href="/FrightDay" />
        <div class="space-label">我的生活空間</div>
        <nav aria-label="主要導覽"><button class="nav-item @(!listView ? "selected" : "")" @onclick="() => listView = false"><FnIcon Name="calendar" />回憶日曆<span class="nav-dot"></span></button><button class="nav-item @(listView ? "selected" : "")" @onclick="() => listView = true"><FnIcon Name="grid" />本月回憶<span class="count">@items.Count</span></button></nav>
        <div class="sidebar-divider"></div><div class="space-label">這個月的小小累積</div>
        <div class="stat-row"><span>收藏的回憶</span><strong>@items.Count<span> 則</span></strong></div><div class="stat-row"><span>有故事的日子</span><strong>@items.Select(x => x.MemoryDate.Date).Distinct().Count()<span> 天</span></strong></div>
        <div class="sidebar-note"><span class="note-star">✦</span><h3>生活不用很盛大，<br />值得記得就好。</h3><p>留下一點今天，<br />送給未來的自己。</p><div class="note-line"></div><span>COLLECT MOMENTS,<br />NOT THINGS.</span></div>
        <div class="profile"><FnAvatar Account="@user" /><div><strong>@user</strong><span>每一天，都算數。</span></div><button class="icon-button" @onclick="Logout" aria-label="登出" title="登出"><FnIcon Name="logout" Size="18" /></button></div>
    </aside>
    <main class="workspace">
        <header class="topbar"><div class="breadcrumb"><a class="mobile-brand" href="/FrightDay" aria-label="Friday Night 回憶日曆"><img src="@Scene.Logo" alt="Friday Night 原創 Logo" width="38" height="38" /></a><span class="breadcrumb-root">我的生活空間</span><span class="breadcrumb-separator">/</span> <strong>@(listView ? "本月回憶" : "回憶日曆")</strong></div><div class="top-actions"><span class="mobile-profile"><FnAvatar Account="@user" Small="true" /></span><span class="scene-status"><FnIcon Name="@(Scene.IsNight ? "moon" : "sun")" Size="14" />@Scene.Label</span><span class="today-label">@Scene.LocalDate.ToString("yyyy.MM.dd")</span><button class="scene-auto-button @(themeAutomatic ? "is-auto" : "")" @onclick="FollowDaylight" aria-label="跟隨日夜外觀" aria-pressed="@themeAutomatic" title="依本機時間自動切換：05:00 白天、17:00 夜晚">自動</button><button class="icon-button theme-button" @onclick="ToggleTheme" aria-label="切換明暗主題"><FnIcon Name="@(dark ? "sun" : "moon")" /></button><button class="mobile-logout icon-button" @onclick="Logout" aria-label="登出"><FnIcon Name="logout" /></button></div></header>
        <div class="page-content">
            <section class="page-heading"><div><span class="eyebrow">A LITTLE LIFE, WELL KEPT.</span><h1>日子裡的<span>小美好。</span></h1><p>把想記住的時刻，輕輕放進日曆裡。</p></div><button class="primary" @onclick="NewMemory" disabled="@busy"><FnIcon Name="plus" Size="18" />新增回憶</button></section>
            <section class="month-banner sea-banner @(Scene.IsNight ? "night-banner" : "day-banner")"><FnSeascape Variant="banner" /><div class="month-banner-copy"><span class="banner-kicker">@month.ToString("MMMM", System.Globalization.CultureInfo.InvariantCulture).ToUpper() · @month.Year</span><h2>每一格，都是生活的模樣。</h2><p>@(Scene.IsNight ? "在月光裡，收藏今天的小小閃光。" : "讓日光與海風，陪你收藏每一天。")</p></div></section>
            @if (!string.IsNullOrEmpty(message)) { <div class="notice @(isError ? "error" : "success")" role="@(isError ? "alert" : "status")"><span>@message</span><button class="icon-button" aria-label="關閉通知" @onclick='() => message = ""'><FnIcon Name="close" Size="16" /></button></div> }
            <section class="calendar-card" aria-busy="@busy">
                <div class="calendar-toolbar"><div class="month-navigation"><h2>@month.ToString("yyyy 年 M 月")</h2><div class="month-buttons"><button class="icon-button" aria-label="上個月" @onclick="() => MoveMonth(-1)" disabled="@(busy || month.Year <= 1900)"><FnIcon Name="left" Size="17" /></button><button class="icon-button" aria-label="下個月" @onclick="() => MoveMonth(1)" disabled="@(busy || month.Year >= 2200)"><FnIcon Name="right" Size="17" /></button></div><button class="text-button today-button" @onclick="Today" disabled="@busy">今天</button></div><div class="calendar-tools"><label class="search-box"><FnIcon Name="search" Size="16" /><input aria-label="搜尋本月回憶" placeholder="搜尋本月回憶…" @bind="search" @bind:event="oninput" /></label><div class="segmented view-switch"><button class="@(!listView ? "active" : "")" @onclick="() => listView = false" aria-label="月曆檢視"><FnIcon Name="calendar" Size="17" /></button><button class="@(listView ? "active" : "")" @onclick="() => listView = true" aria-label="列表檢視"><FnIcon Name="grid" Size="17" /></button></div></div></div>
                @if (busy && items.Count == 0) { <div class="loading-state" role="status"><span class="spinner"></span>正在載入回憶…</div> }
                else if (listView)
                {
                    <div class="memory-grid">@foreach (var item in Filtered) { <button class="memory-tile" @onclick="() => OpenMemory(item)" disabled="@busy"><span class="tile-date">@item.MemoryDate.ToString("MM.dd") <span>@Weekday(item.MemoryDate)</span></span><span class="tile-symbol"><FnIcon Name="@(string.IsNullOrEmpty(item.PicKey) ? "heart" : "image")" Size="30" /></span><strong>@item.Title</strong><span class="tile-meta">@item.CreateAt @(!string.IsNullOrWhiteSpace(item.Locate) ? " · " + item.Locate : "")</span><span class="tile-tags">@item.Tags</span></button> }</div>
                    @if (!Filtered.Any()) { <div class="empty-list"><FnIcon Name="image" Size="35" /><h3>@(search.Length > 0 ? "沒有符合的回憶" : "這個月的故事，等你開始。")</h3><p>@(search.Length > 0 ? "試試其他標題、地點或標籤。" : "從一個小小的瞬間，開始記錄。")</p></div> }
                }
                else
                {
                    <div class="calendar-weekdays">@foreach (var day in weekdays) { <span>@day</span> }</div>
                    <div class="calendar-grid" role="group" aria-label="@month.ToString("yyyy 年 M 月")">
                    @foreach (var date in CalendarDays)
                    {
                        var dayItems = Filtered.Where(x => x.MemoryDate.Date == date).ToList();
                        <div class="calendar-cell @(date.Month != month.Month ? "outside" : "") @(date == selected ? "day-selected" : "") @(date == Scene.LocalDate ? "is-today" : "")">
                            <button class="day-number" @onclick="() => SelectDate(date)" disabled="@busy" aria-label="@date.ToString("yyyy 年 M 月 d 日")" aria-pressed="@(date == selected)">@date.Day</button>
                            <div class="day-events">@foreach (var item in dayItems.Take(2)) { <button class="calendar-event @(item.CreateAt == user ? "own-event" : "")" title="@item.Title" @onclick="() => OpenMemory(item)" disabled="@busy"><span></span>@item.Title</button> } @if (dayItems.Count > 2) { <button class="more-events" @onclick="() => SelectDate(date)">還有 @(dayItems.Count - 2) 則</button> }</div>
                            @if (date == Scene.LocalDate) { <span class="today-cell-label">TODAY</span> }
                        </div>
                    }
                    </div>
                }
                <footer class="calendar-footer"><span><i class="legend-dot"></i>我的回憶 <i class="legend-dot shared"></i>朋友的回憶</span><span>@Filtered.Count() 則回憶，在這個月閃閃發光。</span></footer>
            </section>
            <section class="day-section"><div class="day-heading"><div><span class="eyebrow">A CLOSER LOOK AT YOUR DAY</span><h2>@selected.ToString("M 月 d 日") <span>@Weekday(selected)</span></h2></div><button class="text-button" @onclick="NewMemory" disabled="@busy"><FnIcon Name="plus" Size="16" />為這天加一筆</button></div>
                @if (!SelectedItems.Any()) { <div class="day-empty"><span class="empty-icon"><FnIcon Name="image" Size="25" /></span><div><strong>@(search.Length > 0 ? "這天沒有符合搜尋的回憶。" : "這一天，還有空白等你填滿。")</strong><p>一頓好吃的晚餐，或一次久違的相聚，都可以。</p></div><button class="text-button" @onclick="NewMemory" disabled="@busy">記下一刻 <FnIcon Name="right" Size="16" /></button></div> }
                else { <div class="day-memory-list">@foreach (var item in SelectedItems) { <button class="day-memory" @onclick="() => OpenMemory(item)" disabled="@busy"><FnAvatar Account="@item.CreateAt" /><div><strong>@item.Title</strong><span>@item.CreateAt · @item.Locate @item.Tags</span></div><FnIcon Name="right" Size="18" /></button> }</div> }
            </section>
            <footer class="page-footer"><span>FRIDAY NIGHT MEMORY</span><span>一點一點，拼成我們的生活。</span><FnIcon Name="heart" Size="14" /></footer>
        </div>
    </main>
</div>
@if (editorOpen)
{
    <FnDialog Title="@(editing.Id == 0 ? "收藏一個新時刻" : "編輯這段回憶")" Class="@(dark ? "dark" : "")" OnClose="CloseEditor">
        <EditForm Model="editing" OnValidSubmit="SaveMemory" FormName="memory"><DataAnnotationsValidator /><div class="dialog-body">
            @if (!string.IsNullOrEmpty(dialogError)) { <div class="notice error" role="alert">@dialogError</div> }
            <label for="memory-title">回憶標題</label><InputText id="memory-title" @bind-Value="editing.Title" placeholder="今天，想記住什麼？" maxlength="100" disabled="@saving" /><ValidationMessage For="() => editing.Title" />
            <div class="form-row"><div><label for="memory-date">日期</label><InputDate id="memory-date" @bind-Value="editing.MemoryDate" min="1900-01-01" max="2200-12-31" disabled="@saving" /></div><div><label for="memory-location">地點 <span>選填</span></label><InputText id="memory-location" @bind-Value="editing.Locate" placeholder="故事發生在哪裡？" maxlength="200" disabled="@saving" /></div></div>
            <label for="memory-tags">標籤 <span>選填</span></label><InputText id="memory-tags" @bind-Value="editing.Tags" placeholder="例如：旅行、朋友、小日常" maxlength="200" disabled="@saving" />
            <label>照片 <span>選填 · JPG / PNG / WebP，最大 2 MB</span></label><label class="upload-area" for="memory-picture">@if (!string.IsNullOrEmpty(preview)) { <img src="@preview" alt="回憶照片預覽" /> } else { <FnIcon Name="image" Size="30" /><strong>替回憶放上一張照片</strong><span>點此選擇圖片</span> }<InputFile id="memory-picture" OnChange="ChoosePicture" accept="image/jpeg,image/png,image/webp" disabled="@saving" /></label>
            @if (!string.IsNullOrEmpty(preview)) { <button type="button" class="text-button" @onclick="RemovePicture" disabled="@saving">移除照片</button> }
        </div><footer class="dialog-footer"><button type="button" class="secondary" @onclick="CloseEditor" disabled="@saving">取消</button><button type="submit" class="primary" disabled="@saving"><FnIcon Name="check" Size="18" />@(saving ? "儲存中…" : "儲存這段回憶")</button></footer></EditForm>
    </FnDialog>
}
@if (opened != null)
{
    <FnDialog Title="@opened.Title" Class="@(dark ? "detail-dialog dark" : "detail-dialog")" OnClose="CloseDetail"><div class="dialog-body">
        @if (!string.IsNullOrEmpty(dialogError)) { <div class="notice error" role="alert">@dialogError</div> }
        <div class="detail-meta"><FnAvatar Account="@opened.CreateAt" /><strong>@opened.CreateAt</strong><span>@opened.MemoryDate.ToString("yyyy.MM.dd")</span>@if (opened.CreateAt == user) { <button class="icon-button" aria-label="編輯回憶" @onclick="EditOpened" disabled="@saving"><FnIcon Name="edit" Size="17" /></button><button class="icon-button danger-text" aria-label="刪除回憶" @onclick="() => deleteMemory = true" disabled="@saving"><FnIcon Name="trash" Size="17" /></button> }</div>
        @if (deleteMemory) { <div class="delete-confirm" role="alert"><strong>確定刪除這段回憶？</strong><p>它將從日曆中隱藏，相關留言也不再顯示。</p><button class="secondary" @onclick="() => deleteMemory = false" disabled="@saving">保留回憶</button><button class="danger" @onclick="DeleteOpened" disabled="@saving">確定刪除</button></div> }
        @if (!string.IsNullOrEmpty(detailImage)) { <img class="detail-image" src="@detailImage" alt="@opened.Title" /> }
        <div class="detail-tags">@if (!string.IsNullOrWhiteSpace(opened.Locate)) { <span><FnIcon Name="pin" Size="15" />@opened.Locate</span> } @if (!string.IsNullOrWhiteSpace(opened.Tags)) { <span># @opened.Tags</span> }</div>
        <div class="comments-heading"><h3>在回憶裡聊聊</h3><span>@comments.Count 則留言</span></div>
        @if (comments.Count == 0) { <p class="muted">還沒有留言。來分享你的心情吧。</p> }
        @foreach (var comment in comments.Where(x => x.ReplyId == null))
        {
            <div class="comment"><FnAvatar Account="@comment.CreateAt" Small="true" /><div class="comment-main"><div class="comment-meta"><strong>@comment.CreateAt</strong><time>@comment.CreateDate.ToLocalTime().ToString("MM/dd HH:mm")</time></div><p>@comment.Comment</p><div class="comment-actions"><button @onclick="() => ReplyTo(comment)" disabled="@saving">回覆</button>@if (comment.CreateAt == user) { <button @onclick="() => EditComment(comment)" disabled="@saving">編輯</button><button @onclick="() => pendingDeleteComment = comment.Id" disabled="@saving">刪除</button> }</div></div></div>
            @foreach (var reply in comments.Where(x => x.ReplyId == comment.Id)) { <div class="comment reply"><FnAvatar Account="@reply.CreateAt" Small="true" /><div class="comment-main"><div class="comment-meta"><strong>@reply.CreateAt</strong><time>@reply.CreateDate.ToLocalTime().ToString("MM/dd HH:mm")</time></div><p>@reply.Comment</p>@if (reply.CreateAt == user) { <div class="comment-actions"><button @onclick="() => EditComment(reply)" disabled="@saving">編輯</button><button @onclick="() => pendingDeleteComment = reply.Id" disabled="@saving">刪除</button></div> }</div></div> }
        }
        @if (pendingDeleteComment != null) { <div class="delete-confirm"><p>確定刪除此留言？主留言下的回覆也會隱藏。</p><button class="secondary" @onclick="() => pendingDeleteComment = null" disabled="@saving">取消</button><button class="danger" @onclick="DeleteComment" disabled="@saving">刪除留言</button></div> }
        <form @onsubmit="SaveComment" @onsubmit:preventDefault="true" class="comment-form">@if (replyTo != null || editingComment != null) { <div class="reply-context"><span>@(editingComment != null ? "編輯留言" : "回覆 " + replyTo?.CreateAt)</span><button type="button" class="icon-button" aria-label="取消編輯或回覆" @onclick="ResetComment"><FnIcon Name="close" Size="15" /></button></div> }<label for="comment-input" class="sr-only">留言內容</label><textarea id="comment-input" @bind="commentText" placeholder="留下一點心情…" maxlength="4000" required rows="3" disabled="@saving"></textarea><button class="primary" type="submit" disabled="@saving">@(saving ? "傳送中…" : editingComment != null ? "儲存留言" : "送出留言")<FnIcon Name="right" Size="16" /></button></form>
    </div></FnDialog>
}
