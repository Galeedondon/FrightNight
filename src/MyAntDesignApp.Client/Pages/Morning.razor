@code {
    List<Data> comments => new List<Data>()
    {
        new Data()
        {
            Author = "Han Solo",
            Avatar = @"https://zos.alipayobjects.com/rmsportal/ODTLcjxAfvqbxHnVXCYX.png",
            Content = "We supply a series of design principles, practical patterns and high quality design resources (Sketch and Axure), to help people create their product prototypes beautifully and efficiently.",
            Datetime = @<Tooltip Title="@(DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd HH:mm:ss"))">
                               <span>
                                   @(MomentHelper.FromNow(DateTime.Now.AddDays(-1)))
                               </span>
                            </Tooltip>,
                Actions = new List<RenderFragment>() {replyAction}
        },
        new Data()
        {
            Author = "Han Solo",
            Avatar = @"https://zos.alipayobjects.com/rmsportal/ODTLcjxAfvqbxHnVXCYX.png",
            Content = "We supply a series of design principles, practical patterns and high quality design resources (Sketch and Axure), to help people create their product prototypes beautifully and efficiently.",
            Datetime = @<Tooltip Title="@(DateTime.Now.AddDays(-2).ToString("yyyy-MM-dd HH:mm:ss"))">
                            <span>
                                @(MomentHelper.FromNow(DateTime.Now.AddDays(-2)))
                            </span>
                        </Tooltip>,
            Actions = new List<RenderFragment>() {replyAction}
        }
    };

    RenderFragment replyAction =@<span>Reply to</span>;
    
    RenderFragment header =>
    @<div>
        @if (comments.Any())
        {
            <span>
                @($"{comments.Count} {(comments.Count > 1 ? "replies" : "reply")}")
            </span>
        }
    </div>;
    async void onSubmit()
    {
        submitting = true;

        await Task.Delay(1000);
        this.datas.Add(new Data()
        {
            Author = "Han Solo",
            Avatar = @"https://zos.alipayobjects.com/rmsportal/ODTLcjxAfvqbxHnVXCYX.png",
            Content = _value,
            Datetime = @<div>
                            <span>
                                @(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))
                            </span>
                        </div>,
        });
        submitting = false;
        _value = "";
        await InvokeAsync(StateHasChanged);
    }

    private RenderFragment DateCellRender(DateTime value)
    {
        var CalendarData = GetListData(value);
        return @<Template>
        <ul class="events">
            @foreach (var data in CalendarData)
        {
            <li key="@data.Content">
                <Badge Status="@data.Type" Text="@data.Content" />
            </li>
        }
        </ul>
    </Template>;
    }

    private RenderFragment MonthCellRender(DateTime value)
    {
        int? num = GetMonthData(value);

        if (num == null)
        {
            return null;
        }

        return @<Template>
        <div className="notes-month">
            <section>@num</section>
            <span>Backlog number</span>
        </div>
    </Template>;
    }
}


