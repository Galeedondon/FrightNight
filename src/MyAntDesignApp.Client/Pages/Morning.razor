<style>
    
    .estrela {
        background-color: white;
        border-radius: 50%;
        position: absolute;
        animation-name: estrela;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
    }

    .estrela.style1 {
        animation-duration: 0.5s;
        animation-name: estrela;
    }
    .estrela.style2 {
        animation-duration: 1s;
        animation-name: estrela;
    }
    .estrela.style3 {
        animation-duration: 1.5s;
        animation-name: estrela;
    }
    .estrela.style4 {
        animation-duration: 2s;
        animation-name: estrela;
    }

    .estrela.tam1 {
        width: 1px;
        height: 1px;
    }
    .estrela.tam2 {
        background: #ffffff;
        border-radius: 50%;
        box-shadow: 30px 10px 0px 0px #ffffff,
            /* 原来是 15px 5px */ -30px 10px 0px 0px #ffffff,
            /* 原来是 -15px 5px */ 10px -20px 0px 0px #ffffff,
            /* 原来是 5px -10px */ 50px -10px 0px 0px #ffffff; /* 原来是 25px -5px */
        width: 120px;
        height: 80px;
    }
    .estrela.tam3 {
        width: 3px;
        height: 3px;
    }

    .estrela.opacity1 {
        opacity: 1;
    }
    .estrela.opacity2 {
        opacity: 0.5;
    }
    .estrela.opacity3 {
        opacity: 0.1;
    }
</style>