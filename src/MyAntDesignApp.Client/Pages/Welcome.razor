@page "/"
@namespace MyAntDesignApp.Pages.Components
@using MyAntDesignApp.Client.Components
<PageTitle>Friday Night — 留住生活的光</PageTitle>
<main class="welcome-page @(Scene.IsNight ? "night-welcome dark" : "day-welcome")">
    <FnBrand Class="welcome-brand" />
    <div class="welcome-grid">
        <section class="welcome-story"><span class="eyebrow">YOUR DAYS, YOUR STORIES.</span><h1>把日子，<br />過成值得<br /><span>回看的故事。</span></h1><p>一張照片、一段對話、平凡裡的小小閃光。<br />在 Friday Night，讓每一天都有地方收藏。</p>
            <FnSeascape Variant="welcome" />
            <span class="story-foot"><FnIcon Name="heart" Size="15" /> 為那些想記得的時刻，留一個位置。</span>
        </section>
        <section class="auth-card glass"><span class="eyebrow">WELCOME TO YOUR LITTLE WORLD</span><h2>@(register ? "故事，從這裡開始。" : "嗨，歡迎回來。")</h2><p>@(register ? "建立帳號，開始收集你的回憶。" : "今天，有什麼值得記下來的事？")</p>
            <div class="segmented auth-tabs"><button class="@(!register ? "active" : "")" @onclick="() => Switch(false)" disabled="@busy">登入</button><button class="@(register ? "active" : "")" @onclick="() => Switch(true)" disabled="@busy">建立帳號</button></div>
            @if (!string.IsNullOrEmpty(error)) { <div class="notice error" role="alert">@error</div> }
            @if (!string.IsNullOrEmpty(success)) { <div class="notice success" role="status">@success</div> }
            <EditForm Model="form" OnValidSubmit="Submit" FormName="authentication"><DataAnnotationsValidator />
                <label for="account">帳號</label><InputText id="account" @bind-Value="form.Account" autocomplete="username" placeholder="你的專屬名稱" maxlength="40" disabled="@busy" /><ValidationMessage For="() => form.Account" />
                <label for="password">密碼</label><InputText id="password" type="password" @bind-Value="form.Password" autocomplete="@(register ? "new-password" : "current-password")" placeholder="至少 8 個字元" maxlength="128" disabled="@busy" /><ValidationMessage For="() => form.Password" />
                @if (register) { <label for="confirm">再次輸入密碼</label><input id="confirm" type="password" @bind="confirmation" autocomplete="new-password" required maxlength="128" disabled="@busy" /> }
                <button type="submit" class="primary auth-submit" disabled="@busy">@(busy ? "處理中…" : register ? "建立我的回憶日曆" : "開啟我的日曆") <FnIcon Name="right" Size="18" /></button>
            </EditForm>
            <div class="auth-bottom"><span class="small-orbit"></span> 好好生活，慢慢記錄。</div>
        </section>
    </div>
    <footer class="welcome-footer"><span>FRIDAY NIGHT MEMORY</span><span>每個平凡的日子，都有不平凡的記憶。</span><span>MADE FOR YOUR MOMENTS.</span></footer>
</main>
