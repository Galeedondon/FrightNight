@inject IJSRuntime JS
<dialog @ref="element" class="fn-dialog @Class" aria-labelledby="dialog-title" @oncancel="Dismiss" @oncancel:preventDefault="true">
    <header class="dialog-header"><div><span class="eyebrow">FRIDAY NIGHT MEMORY</span><h2 id="dialog-title">@Title</h2></div><button class="icon-button" aria-label="關閉視窗" @onclick="Dismiss"><FnIcon Name="close" /></button></header>
    @ChildContent
</dialog>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private ElementReference element;
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) await JS.InvokeVoidAsync("fn.openDialog", element); }
    private async Task Dismiss() { await JS.InvokeVoidAsync("fn.closeDialog", element); await OnClose.InvokeAsync(); }
}
