@using MyAntDesignApp.CommonService
<div class="seascape @(Scene.IsNight ? "sea-night" : "sea-day") seascape-@Variant" role="img" aria-label="@(Scene.Label + "，海面上漂浮著原創漂流瓶")">
    <div class="sea-grain" aria-hidden="true"></div>
    <div class="sky-orb" aria-hidden="true">
        <svg viewBox="0 0 64 64" focusable="false">
            @if (Scene.IsNight)
            {
                <path class="moon-crescent" d="M47 7A27 27 0 1 0 57 48A27 27 0 0 1 47 7Z" />
            }
            else
            {
                <circle class="sun-disc" cx="32" cy="32" r="27" />
            }
        </svg>
    </div>
    @if (!Scene.IsNight)
    {
        @foreach (var cloud in new[] { "cloud-one", "cloud-two", "cloud-three" })
        {
            <span class="sky-cloud @cloud" aria-hidden="true"><svg viewBox="0 0 120 54" focusable="false"><path d="M22 49a17 17 0 0 1-1-34 24 24 0 0 1 45-4 19 19 0 0 1 32 9 15 15 0 0 1-1 29Z" /></svg></span>
        }
    }
    else
    {
        <div class="sky-stars" aria-hidden="true">@for (var i = 0; i < 21; i++) { <i style="@($"left:{8 + (i * 37) % 85}%;top:{8 + (i * 19) % 49}%;--delay:{i % 5}s")"></i> }</div>
        <span class="shooting-star" aria-hidden="true"></span>
    }
    <div class="sea-horizon" aria-hidden="true"></div><div class="sea-reflection" aria-hidden="true"></div>
    <div class="sea-wave wave-back" aria-hidden="true"></div>
    <div class="drifting-bottle" aria-hidden="true"><img src="@Scene.Bottle" alt="" width="4070" height="3721" decoding="async" /></div>
    <div class="sea-wave wave-front" aria-hidden="true"></div>
    @if (Variant == "welcome")
    {
        <div class="sea-caption"><span>MESSAGE IN A BOTTLE</span><strong>把今天，寄給未來的自己。</strong></div>
        <span class="sea-time-label"><FnIcon Name="@(Scene.IsNight ? "moon" : "sun")" Size="13" />@Scene.Label</span>
    }
</div>
@code {
    [CascadingParameter] public SceneService Scene { get; set; } = default!;
    [Parameter] public string Variant { get; set; } = "welcome";
}
